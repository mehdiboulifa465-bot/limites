/* ============ OUTILS & ÉTAT ============ */
const $ = s => document.querySelector(s);
const shuffle = a => a.map(x=>[Math.random(),x]).sort((p,q)=>p[0]-q[0]).map(x=>x[1]);
let state = {xp:+localStorage.getItem("lq_xp")||0, badges:JSON.parse(localStorage.getItem("lq_b")||"[]")};
let inGame = false;

function save(){localStorage.setItem("lq_xp",state.xp);localStorage.setItem("lq_b",JSON.stringify(state.badges))}
function addBadge(b){if(!state.badges.includes(b)){state.badges.push(b);save()}}
function levelName(){const x=state.xp;return x<100?"Débutant 🌱":x<300?"Apprenti 📘":x<600?"Calculateur 🧮":x<1000?"Expert 🎓":"Maître des limites 👑"}
function shuffleQ(q){const idx=shuffle(q.o.map((t,i)=>i));return {...q,o:idx.map(i=>q.o[i]),a:idx.indexOf(q.a)}}

function render(el){
  const target = el || document.body;
  if(window.renderMathInElement){
    renderMathInElement(target,{
      delimiters:[{left:"$$",right:"$$",display:true},{left:"$",right:"$",display:false}],
      throwOnError:false
    });
  } else { setTimeout(()=>render(el),100); }
}

function setScreen(html){
  $("#screen").innerHTML = html;
  render($("#screen"));
  document.body.classList.toggle("in-game", inGame);
}

