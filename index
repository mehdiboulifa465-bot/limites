  </div>`);
}

/* ============ MOTEUR QCM STANDARD ============ */
function runQCM(questions,{title,timer=0,xpPer=10,badge=null}){
  inGame = true;
  let i=0,score=0,lives=3,t=null;
  const qs=questions.map(shuffleQ);

  function show(){
    clearInterval(t);
    if(!inGame) return;
    if(i>=qs.length||lives<=0)return end();
    const q=qs[i];
    setScreen(`<div class="card">
      <div class="bar"><span>${title}</span><span>${"❤️".repeat(lives)}</span><span>${i+1}/${qs.length} · ✔ ${score}</span></div>
      ${timer?'<div class="timer"><div id="tb"></div></div>':''}
      <div class="q">${q.q}</div>
      ${q.o.map((o,k)=>`<button class="opt" data-k="${k}">${o}</button>`).join("")}
      <div id="fb"></div></div>`);
    document.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{playSound('click');answer(+b.dataset.k)});
    if(timer){
      let left=timer*10;
      t=setInterval(()=>{
        if(!inGame){clearInterval(t);return}
        left--;
        $("#tb").style.width=(left/(timer*10)*100)+"%";
        if(left<=0){clearInterval(t);answer(-1)}
      },100);
    }
  }

  function answer(k){
    clearInterval(t);
    if(!inGame) return;
    const q=qs[i],btns=document.querySelectorAll(".opt");
    btns.forEach(b=>b.onclick=null);
    btns[q.a].classList.add("ok");
    if(k===q.a){
      score++;state.xp+=xpPer;
      playSound('success');
    } else {
      lives--;
      if(k>=0)btns[k].classList.add("ko");
      playSound('error');
    }
    $("#fb").innerHTML=`<div class="fb">${k===q.a?"✅ Bravo !":k<0?"⏰ Temps écoulé !":"❌ Raté."} ${q.e}</div><button class="opt next" id="nx">Suivant ➜</button>`;
    render($("#fb"));
    $("#nx").onclick=()=>{playSound('click');i++;show()};
    save();
  }

  function end(){
    inGame = false;
    const win=score>=Math.ceil(qs.length*0.7);
    if(win){
      if(badge)addBadge(badge);
      playSound('win');
    } else {
      playSound('error');
    }
    if(score===qs.length)addBadge("💯 Sans faute – "+title);
    save();
    setScreen(`<div class="card" style="text-align:center">
      <h2>${lives<=0?"💀 Plus de vies !":win?"🏆 Victoire !":"Fin de partie"}</h2>
      <p style="font-size:1.3em">Score : ${score}/${qs.length}</p>
      <p>${win&&badge?"Badge débloqué : "+badge:""}</p>
      <div class="menu"><button onclick="menu()">Retour au menu</button></div></div>`);
  }
  show();
}

function startQuiz(l){
  const pool=shuffle(QCM.filter(q=>q.lvl===l)).slice(0,8);
  runQCM(pool,{title:"Niveau "+l,xpPer:10*l,badge:["","🥉 Niveau 1","🥈 Niveau 2","🥇 Niveau 3"][l]});
}
function startContinuity(){
  runQCM(shuffle(CONTINUITY),{title:"Continuité & TVI",xpPer:15,badge:"📘 Maître du TVI"});
}
function startChrono(){runQCM(shuffle(QCM).slice(0,10),{title:"Chrono",timer:10,xpPer:20,badge:"⚡ Éclair"})}
function startAsymp(){runQCM(shuffle(ASYMP),{title:"Asymptotes",xpPer:15,badge:"📈 Chasseur d'asymptotes"})}

/* ============ MODE DUEL 2 JOUEURS ============ */
function startDuel(){
  inGame = true;
  const qs = shuffle(QCM).slice(0, 10);
  let i = 0, p1Score = 0, p2Score = 0, turn = 1;

  function show(){
    if(!inGame) return;
    if(i >= qs.length) return end();
    const q = qs[i];
    setScreen(`<div class="card">
      <div class="bar"><span>⚔️ Mode Duel</span><span style="color:${turn===1?'#4338ca':'#dc2626'}">Tour du Joueur ${turn} (${turn===1?'🔵':'🔴'})</span><span>Q ${i+1}/${qs.length}</span></div>
      <div style="display:flex;justify-content:space-around;font-weight:bold;margin-bottom:10px">
        <span style="color:#4338ca">Joueur 1 : ${p1Score} pts</span>
        <span style="color:#dc2626">Joueur 2 : ${p2Score} pts</span>
      </div>
      <div class="q">${q.q}</div>
      ${q.o.map((o,k)=>`<button class="opt" data-k="${k}">${o}</button>`).join("")}
      <div id="fb"></div></div>`);
    document.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{playSound('click');answer(+b.dataset.k)});
  }

  function answer(k){
    if(!inGame) return;
    const q=qs[i], btns=document.querySelectorAll(".opt");
    btns.forEach(b=>b.onclick=null);
    btns[q.a].classList.add("ok");
    const correct = (k === q.a);
    if(correct){
      if(turn === 1) p1Score++; else p2Score++;
      playSound('success');
    } else {
      if(k >= 0) btns[k].classList.add("ko");
      playSound('error');
    }
    $("#fb").innerHTML=`<div class="fb">${correct?"✅ Bonne réponse pour J"+turn+" !":"❌ Raté."} ${q.e}</div><button class="opt next" id="nx">Joueur suivant ➜</button>`;
    render($("#fb"));
    $("#nx").onclick = () => {
      playSound('click');
      turn = turn === 1 ? 2 : 1;
      if(turn === 1) i++;
      show();
    };
  }

  function end(){
    inGame = false;
    let winner = p1Score > p2Score ? "🏆 Victoire du Joueur 1 (🔵) !" : p2Score > p1Score ? "🏆 Victoire du Joueur 2 (🔴) !" : "🤝 Égalité parfaite !";
    state.xp += 30; addBadge("⚔️ Duelliste"); save();
    playSound('win');
    setScreen(`<div class="card" style="text-align:center">
      <h2>Fin du Duel !</h2>
      <p style="font-size:1.4em;font-weight:bold">${winner}</p>
      <p>Score final : J1 (${p1Score}) - J2 (${p2Score})</p>
      <div class="menu"><button onclick="menu()">Retour au menu</button></div></div>`);
  }
  show();
}

/* ============ VISUALISEUR GEOGEBRA & ASYMPTOTES ============ */
function startGeoGebra(){
  inGame = true;
  setScreen(`<div class="card">
    <h2>Visualiseur GeoGebra &amp; Asymptotes</h2>
    <p>Explore les fonctions et leurs asymptotes dynamiquement :</p>
    <div class="menu" style="display:flex;gap:8px;flex-wrap:wrap">
      <button onclick="playSound('click');loadGGB('f(x)=(2x+1)/(x-3)')" style="flex:1">$\\displaystyle f(x)=\\frac{2x+1}{x-3}$</button>
      <button onclick="playSound('click');loadGGB('f(x)=e^x+3')" style="flex:1">$\\displaystyle f(x)=e^x+3$</button>
      <button onclick="playSound('click');loadGGB('f(x)=(x^2+1)/(x-1)')" style="flex:1">$\\displaystyle f(x)=\\frac{x^2+1}{x-1}$</button>
    </div>
    <div class="ggb-container">
      <iframe id="ggbFrame" src="https://www.geogebra.org/classic?embed&amp;showToolBar=false&amp;showAlgebraInput=false&amp;showMenuBar=false"></iframe>
    </div>
    <div id="ggbDesc" class="fb" style="font-size:1.05em">Sélectionne une fonction ci-dessus pour afficher son analyse.</div>
    <div class="menu" style="margin-top:15px"><button class="back" onclick="menu()">⬅ Menu</button></div>
  </div>`);
  render($("#screen"));
}

function loadGGB(expr){
  let desc = "";
  if(expr.includes("2x+1")){
    desc = "<b>Analyse de $\\displaystyle f(x) = \\frac{2x+1}{x-3}$</b><br>• Asymptote verticale : $\\mathbf{x = 3}$<br>• Asymptote horizontale en $\\pm\\infty$ : $\\mathbf{y = 2}$";
  } else if(expr.includes("e^x")){
    desc = "<b>Analyse de $\\displaystyle f(x) = e^x + 3$</b><br>• Asymptote horizontale en $-\\infty$ : $\\mathbf{y = 3}$<br>• Croissance exponentielle rapide en $+\\infty$";
  } else {
    desc = "<b>Analyse de $\\displaystyle f(x) = \\frac{x^2+1}{x-1} = x + 1 + \\frac{2}{x-1}$</b><br>• Asymptote verticale : $\\mathbf{x = 1}$<br>• Asymptote oblique en $\\pm\\infty$ : $\\mathbf{y = x + 1}$";
  }
  $("#ggbDesc").innerHTML = desc;
  render($("#ggbDesc"));
}

/* ============ VRAI / FAUX ============ */
function startVF(){
  inGame = true;
  const qs=shuffle(VF).slice(0,8);let i=0,score=0;
  function show(){
    if(i>=qs.length){
      inGame=false;
      if(score>=4)addBadge("🧠 Esprit critique");save();
      playSound('win');
      return setScreen(`<div class="card" style="text-align:center"><h2>Score : ${score}/${qs.length}</h2><div class="menu"><button onclick="menu()">Menu</button></div></div>`)
    }
    setScreen(`<div class="card"><div class="bar"><span>Vrai ou Faux</span><span>${i+1}/${qs.length}</span></div>
      <div class="q">${qs[i].q}</div>
      <button class="opt" id="v">✅ Vrai</button><button class="opt" id="f">❌ Faux</button><div id="fb"></div></div>`);
    $("#v").onclick=()=>{playSound('click');rep(true)};
    $("#f").onclick=()=>{playSound('click');rep(false)};
  }
  function rep(r){
    const ok=r===qs[i].a;
    if(ok){score++;state.xp+=10;playSound('success')}else{playSound('error')}
    save();
    $("#v").onclick=$("#f").onclick=null;
    $("#fb").innerHTML=`<div class="fb">${ok?"✅ Exact !":"❌ Non."} ${qs[i].e}</div><button class="opt next" id="nx">Suivant ➜</button>`;
    render($("#fb"));
    $("#nx").onclick=()=>{playSound('click');i++;show()};
  }
  show();
}

/* ============ DUEL DU BOSS ============ */
function startBoss(){
  inGame = true;
  const qs=shuffle(BOSS);let i=0,hp=100,me=3;const dmg=100/qs.length;
  const norm=s=>s.toLowerCase().replace(/\s/g,"").replace("−","-");
  function show(msg=""){
    if(hp<=1){
      inGame=false;
      addBadge("🐉 Tueur de Boss");state.xp+=100;save();
      playSound('win');
      return setScreen(`<div class="card" style="text-align:center"><h2>🎉 Le Boss est vaincu ! +100 XP</h2><div class="menu"><button onclick="menu()">Menu</button></div></div>`)
    }
    if(me<=0||i>=qs.length){
      inGame=false;
      playSound('error');
      return setScreen(`<div class="card" style="text-align:center"><h2>💀 Le Boss t'a vaincu…</h2><p>Révise et reviens !</p><div class="menu"><button onclick="menu()">Menu</button></div></div>`)
    }
    setScreen(`<div class="card">
      <div class="bar"><span>🐉 Boss Infini</span><span>Toi : ${"❤️".repeat(me)}</span></div>
      <div class="boss-hp"><div style="width:${hp}%"></div></div>
      ${msg?`<div class="fb">${msg}</div>`:""}
      <div class="q">${qs[i].q}</div>
      <input type="text" id="ans" placeholder="Ta réponse (ex : 3/2, 0, +inf, -inf)" autofocus>
      <button class="opt next" id="go">⚔️ Attaquer</button></div>`);
    $("#ans").addEventListener("keydown",e=>{if(e.key==="Enter")$("#go").click()});
    $("#go").onclick=()=>{
      playSound('click');
      const v=norm($("#ans").value);const ok=qs[i].a.map(norm).includes(v);
      const e=qs[i].e;i++;
      if(ok){hp-=dmg;state.xp+=15;save();playSound('hit');show("✅ Touché ! "+e)}else{me--;playSound('error');show("❌ Raté. "+e)}
    };
  }
  show();
}

/* ============ MEMORY ============ */
function startMemory(){
  inGame = true;
  let cards=[];PAIRS.forEach((p,k)=>{cards.push({id:k,t:p[0]});cards.push({id:k,t:p[1]})});
  cards=shuffle(cards);let open=[],found=0,moves=0,lock=false;
  setScreen(`<div class="card"><div class="bar"><span>Memory</span><span id="mv">Coups : 0</span></div>
    <div id="grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px"></div>
    <div class="menu"><button class="back" onclick="menu()">⬅ Menu</button></div></div>`);
  const grid=$("#grid");
  cards.forEach(c=>{
    const b=document.createElement("button");
    b.className="mem";b.textContent="?";
    b.onclick=()=>{
      if(lock||b.dataset.done||open.includes(b))return;
      playSound('click');
      b.innerHTML=c.t;render(b);b.style.background="#fbbf24";b.style.color="#1e1b4b";open.push(b);b._c=c;
      if(open.length===2){
        moves++;$("#mv").textContent="Coups : "+moves;
        const [x,y]=open;
        if(x._c.id===y._c.id){
          x.dataset.done=y.dataset.done=1;
          x.style.background=y.style.background="#22c55e";
          x.style.color=y.style.color="#fff";
          open=[];found++;
          playSound('success');
          if(found===PAIRS.length){
            state.xp+=50;addBadge("🃏 Mémoire d'éléphant");save();
            playSound('win');
            setTimeout(()=>alert("Bravo en "+moves+" coups ! +50 XP"),200);
          }
        } else {
          lock=true;
          playSound('error');
          setTimeout(()=>{
            open.forEach(z=>{z.textContent="?";z.style.background="#6366f1";z.style.color="#fff"});
            open=[];lock=false;
          },1000);
        }
      }
    };
    grid.appendChild(b);
  });
}

window.addEventListener("load",menu);
</script>
