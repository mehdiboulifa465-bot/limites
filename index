    <div>${state.badges.map(b=>`<span class="badge">${b}</span>`).join("")||"<i>Aucun badge pour l'instant</i>"}</div>
  </div>
  <div class="card menu">
    <h2>Choisis ton mode de jeu</h2>
    <button onclick="playSound('success');startQuiz(1)">🟢 Quiz – Niveau 1 : Limites usuelles</button>
    <button onclick="playSound('success');startQuiz(2)">🟡 Quiz – Niveau 2 : Formes indéterminées</button>
    <button onclick="playSound('success');startQuiz(3)">🔴 Quiz – Niveau 3 : Croissances comparées</button>
    <button onclick="playSound('success');startContinuity()">📘 Quiz – Continuité &amp; TVI</button>
    <button onclick="playSound('success');startChrono()">⏱️ Mode Chrono (10 s par question)</button>
    <button onclick="playSound('success');startAsymp()">📈 Chasse aux asymptotes</button>
    <button onclick="playSound('success');startDuel()">⚔️ Mode Duel (2 Joueurs)</button>
    <button onclick="playSound('success');startGeoGebra()">🔍 Visualiseur GeoGebra &amp; Asymptotes</button>
    <button onclick="playSound('success');startVF()">✅ Vrai ou Faux ?</button>
    <button onclick="playSound('success');startBoss()">🐉 Duel du Boss (réponses à saisir)</button>
    <button onclick="playSound('success');startMemory()">🃏 Memory : fonction ↔ limite</button>
    <button style="background:#f59e0b" onclick="playSound('success')">🔊 Tester le son</button>
